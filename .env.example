# Environment Configuration

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Used by backend and workers.
DATABASE_URL=postgresql+asyncpg://helios:password@localhost:5432/helios

# ── Cache / Message Bus ───────────────────────────────────────────────────────
# Redis is used for job queuing, event pub/sub, and caching.
REDIS_URL=redis://localhost:6379

# ── AI Providers ──────────────────────────────────────────────────────────────
# Set the provider(s) you intend to use. At least one is required for Phase 4+.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider for completion tasks: "anthropic" | "openai" | "ollama"
AI_PROVIDER=anthropic

# Default model for completion tasks
AI_MODEL=claude-opus-4-5

# Default embedding model (dimension must match database/schema.sql vector(N))
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=                    # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Authentication (Phase 2) ──────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ── Connectors (Phase 3) ──────────────────────────────────────────────────────
# API keys for connectors that require authentication.
# Danish portals (jobbank, jobdanmark, jobindex, jobnet) are public — no key needed.
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# Maximum jobs to fetch per connector run (safety limit)
CONNECTOR_MAX_RESULTS=200

# ── Workers (Phase 3) ─────────────────────────────────────────────────────────
# How often the ingestion worker runs connector scans (cron expression)
INGESTION_CRON=0 */6 * * *     # every 6 hours

# ── Notifications (Phase 6) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=notifications@helios.app
